# Copy to .env.local and fill in. .env.local is gitignored - never commit real keys.
#
# LOCAL DEVELOPMENT ONLY.
# On Amplify the app gets temporary credentials from the SSR Compute role, so
# only S3_BUCKET and S3_REGION are set there - never the two AWS_* keys below.

S3_BUCKET=vidyabhumi-assets
S3_REGION=ap-south-1

# Optional - these are the defaults
# S3_NEWSLETTER_PREFIX=newsletters/
# S3_IMAGE_PREFIX=images/

# From an IAM user with read-only access to the bucket.
# Prefer `aws configure` instead: the SDK picks those up automatically and
# nothing lands in a file inside the project.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Shared secret for POST /api/newsletter-upload. Generate with:
#   openssl rand -hex 24
# Leave unset to disable the upload endpoint entirely (it then returns 503).
UPLOAD_TOKEN=
